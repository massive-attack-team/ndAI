{
  "manifest_version": 3,
  "name": "ndAI",
  "version": "0.3.0",
  "description": "Checks what you are about to send to an AI assistant before it leaves your machine.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*"
  ],
  "background": { "service_worker": "dist/background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ndAI" },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["dist/content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
